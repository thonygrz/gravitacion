# Copia este fichero como .env.local y rellena los valores. .env.local no se sube al repositorio.

# Clave de la API de Anthropic. Solo la lee el servidor. Sin ella, el tutor queda en modo
# reducido: el panel lo avisa y las preguntas de comprobación se corrigen con su explicación fija.
ANTHROPIC_API_KEY=

# Modelo del tutor. Opcional: si se deja vacío, claude-haiku-5-5.
TUTOR_MODEL=
